 {
  "key": "alist",
  "route": "go_only",
  "repo": "https://github.com/alist-org/alist",
  "tag": "v3.66.0",
  "prepare": [
   "mkdir -p public && cd public && curl -fsSL --retry 3 https://github.com/alist-org/alist-web/releases/latest/download/dist.tar.gz -o dist.tar.gz && tar -xzf dist.tar.gz && rm -f dist.tar.gz",
   "printf 'package public\n\nimport \"embed\"\n\n//go:embed dist\nvar Public embed.FS\n' > public/public.go"
  ],
  "bins": [
   {
    "pkg": "./",
    "out": "alist"
   }
  ],
  "smoke": {
   "type": "http",
   "ports": [
    "5244"
   ],
   "path": "/",
   "wait": 8
  },
  "df_cmd": "[\"server\"]"
