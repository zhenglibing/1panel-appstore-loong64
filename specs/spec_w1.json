   ],
   "wait": 3
  },
  "prepare": [
   "npm install -g pnpm@10.33.2 --registry=https://registry.npmmirror.com || true",
   "pnpm install --frozen-lockfile --registry=https://registry.npmmirror.com",
   "pnpm build:all",
