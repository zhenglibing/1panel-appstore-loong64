 {
  "key": "sftpgo",
  "route": "go_only",
  "repo": "https://github.com/drakkan/sftpgo",
  "tag": "v2.7.6",
  "bins": [
   {
    "pkg": "./",
    "out": "sftpgo",
    "tags": "sqlite"
   }
  ],
  "smoke": {
   "type": "http",
   "ports": [
    "8080"
   ],
   "path": "/",
   "wait": 6
  },
  "df_cmd": "[\"serve\"]",
  "df_extra": "ENV SFTPGO_CONFIG_DIR=/srv/sftpgo SFTPGO_DATA_PROVIDER__DRIVER=bolt SFTPGO_DATA_PROVIDER__SOURCE=sftpgo.bolt\nCOPY sftpgo.json /srv/sftpgo/sftpgo.json\nCOPY templates /srv/sftpgo/templates\nRUN addgroup -S sftpgo && adduser -S -G sftpgo sftpgo && mkdir -p /srv/sftpgo/data /srv/sftpgo/keys /srv/sftpgo/backups && chown -R sftpgo:sftpgo /srv/sftpgo\nUSER sftpgo",
  "files": {
   "sftpgo.json": "{\n  \"data\": {\n    \"provider\": \"bolt\"\n  }\n}\n"
  },
  "copy": [
   {
    "src": "templates",
    "dst": "templates"
   }
  ]
 },
